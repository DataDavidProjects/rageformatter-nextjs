{
	"$schema": "https://ui.shadcn.com/schema.json",
	"style": "new-york",
	"rsc": true,
	"tsx": true,
	"tailwind": {
		"config": "tailwind.config.js",
		"css": "src/app/globals.css",
		"baseColor": "neutral",
		"cssVariables": true,
		"prefix": ""
	},
	"iconLibrary": "lucide",
	"aliases": {
		"components": "@/components",
		"utils": "@/lib/utils",
		"ui": "@/components/ui",
		"lib": "@/lib",
		"hooks": "@/hooks"
	},
	"registries": {
		"@shadcn-ui-blocks": {
			"url": "https://www.shadcn-ui-blocks.com/r/{name}.json",
			"headers": {
				"Authorization": "Bearer ${SHADCN_UI_BLOCKS_API_KEY}"
			}
		}
	}
}
